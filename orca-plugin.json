{
  "manifestVersion": 2,
  "id": "hwp-viewer",
  "name": "HWP Viewer",
  "version": "0.3.0",
  "description": "Orca에서 한글 문서를 볼 수 있습니다. Read Hangul (.hwp, .hwpx) documents in Orca with their original page layout.",
  "author": {
    "name": "chabinhwang",
    "url": "https://github.com/chabinhwang"
  },
  "repository": "https://github.com/chabinhwang/orca-hwp-viewer",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "contributes": {
    "customEditors": [
      {
        "id": "hwp",
        "title": "HWP Preview",
        "extensions": [".hwp", ".hwpx"],
        "entry": "editor/main.ts",
        "priority": "default",
        "contentKind": "bytes",
        "frame": "isolated"
      }
    ]
  }
}
